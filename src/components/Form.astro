<section id="contact" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="section-card grid gap-6 p-5 sm:p-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:p-8">
      <div class="space-y-5">
        <div>
          <p class="eyebrow">Contacto</p>
          <h2 class="section-title max-w-3xl">Si el proyecto merece precisión, podemos hablar.</h2>
          <p class="section-copy">
            Espacio abierto para consultoría, colaboración técnica o conversaciones sobre arquitectura, producto digital y calidad de ingeniería.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <a href="mailto:antony.mongelopez@ucr.ac.cr" class="rounded-[1.25rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-3.5 transition hover:border-[var(--border-strong)]">
            <p class="text-xs uppercase tracking-[0.16em] text-[var(--text-muted)]">Correo</p>
            <p class="mt-2 text-base font-semibold text-[var(--text-primary)]">antony.mongelopez@ucr.ac.cr</p>
            <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">Respuesta clara y directa para proyectos o consultas.</p>
          </a>

          <a
            href="https://www.linkedin.com/in/antony-monge-lopez/"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-[1.25rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-3.5 transition hover:border-[var(--border-strong)]"
          >
            <p class="text-xs uppercase tracking-[0.16em] text-[var(--text-muted)]">LinkedIn</p>
            <p class="mt-2 text-base font-semibold text-[var(--text-primary)]">Perfil profesional</p>
            <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">Canal ideal para networking, oportunidades y contexto profesional.</p>
          </a>
        </div>

        <div class="rounded-[1.45rem] border border-[var(--border-soft)] bg-[var(--bg-card-strong)] p-4 sm:p-5">
          <p class="text-xs uppercase tracking-[0.16em] text-[var(--text-muted)]">Disponibilidad</p>
          <p class="mt-2 text-lg font-extrabold text-[var(--text-primary)]">Consultoría, colaboración y nuevos retos</p>
          <p class="mt-2 text-sm leading-7 text-[var(--text-secondary)]">
            Si necesitas una mano con arquitectura, mejora de experiencia o una implementación front-end más sólida, este es un buen momento para iniciar.
          </p>
        </div>
      </div>

      <div class="rounded-[1.55rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-4 sm:p-5">
        <form id="contact-form" class="grid gap-4" novalidate>
          <div class="grid gap-2">
            <label for="from_name" class="text-sm font-semibold text-[var(--text-primary)]">Nombre</label>
            <input
              id="from_name"
              name="from_name"
              type="text"
              autocomplete="name"
              placeholder="Tu nombre"
              class="min-h-12 rounded-2xl border border-[var(--border-soft)] bg-[var(--bg-card-strong)] px-4 text-[var(--text-primary)] placeholder:text-[var(--text-muted)]"
            />
          </div>

          <div class="grid gap-2">
            <label for="from_email" class="text-sm font-semibold text-[var(--text-primary)]">Correo electrónico</label>
            <input
              id="from_email"
              name="from_email"
              type="email"
              autocomplete="email"
              placeholder="tu@correo.com"
              required
              class="min-h-12 rounded-2xl border border-[var(--border-soft)] bg-[var(--bg-card-strong)] px-4 text-[var(--text-primary)] placeholder:text-[var(--text-muted)]"
            />
          </div>

          <div class="grid gap-2">
            <label for="message" class="text-sm font-semibold text-[var(--text-primary)]">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Cuéntame sobre tu proyecto, reto técnico o necesidad de producto."
              class="rounded-[1.5rem] border border-[var(--border-soft)] bg-[var(--bg-card-strong)] px-4 py-3 text-[var(--text-primary)] placeholder:text-[var(--text-muted)]"
            ></textarea>
          </div>

          <p class="status-text" role="status" aria-live="polite" data-form-status>
            Puedes escribir tu mensaje cuando quieras.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <button
              id="contact-submit"
              type="submit"
              class="button-primary"
              data-default-label="Enviar mensaje"
            >
              Enviar mensaje
            </button>
            <button id="contact-reset" type="button" class="button-secondary">
              Limpiar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
