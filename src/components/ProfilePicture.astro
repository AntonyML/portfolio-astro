---
import SafeImage from "./SafeImage.astro";
import { experience, projects } from "../assets/data";

const totalCaseStudies = experience.length + projects.length;
---

<section id="home" class="section-space hero-section scroll-mt-24">
  <div class="page-wrap">
    <div class="hero-grid items-center">
      <div class="flex flex-col gap-6">
        <div class="inline-flex w-fit items-center gap-2.5 rounded-full border border-[var(--border-soft)] bg-[var(--bg-card)] px-3.5 py-1.5 text-[0.92rem] text-[var(--text-secondary)] shadow-[var(--shadow-card)]">
          <span class="h-2 w-2 rounded-full bg-[var(--success)]"></span>
          Disponible para consultoría, arquitectura y producto digital.
        </div>

        <div class="space-y-4">
          <p class="eyebrow">Portafolio 2026</p>
          <h1 class="hero-title max-w-4xl font-bold uppercase text-[var(--text-primary)]">
            Software elegante,
            <span class="block text-[var(--accent-strong)]">decisiones sólidas</span>
            y productos que escalan.
          </h1>
          <p class="hero-lead">
            Diseño, construyo y evoluciono sistemas empresariales con foco en arquitectura, claridad técnica y experiencias digitales que se sienten pulidas en cada punto de contacto.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="#projects" class="button-primary">
            Ver proyectos
            <i class="bx bx-right-arrow-alt text-xl" aria-hidden="true"></i>
          </a>
          <a href="#contact" class="button-secondary">Iniciar conversación</a>
        </div>

        <div class="hero-stat-grid">
          <div class="section-card p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Casos reales</p>
            <p class="mt-1.5 text-[1.65rem] font-extrabold text-[var(--text-primary)]">{totalCaseStudies}</p>
            <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Proyectos y consultorías con impacto técnico real.</p>
          </div>
          <div class="section-card p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Especialidad</p>
            <p class="mt-1.5 text-base font-extrabold text-[var(--text-primary)]">Arquitectura + delivery</p>
            <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Decisión técnica con ejecución mantenible.</p>
          </div>
          <div class="section-card p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Enfoque</p>
            <p class="mt-1.5 text-base font-extrabold text-[var(--text-primary)]">UX + calidad</p>
            <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Claridad, performance y ritmo visual.</p>
          </div>
        </div>
      </div>

      <aside class="section-card relative overflow-hidden p-3.5 sm:p-5">
        <div class="absolute inset-x-10 top-0 h-28 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>
        <div class="relative rounded-[1.5rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-2.5">
          <div class="absolute left-3.5 top-3.5 rounded-full border border-[var(--border-soft)] bg-[var(--bg-card)] px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]">
            Arquitectura de software
          </div>

          <SafeImage
            imageName="image-profile"
            alt="Retrato de Antony Monge"
            class="h-[19.5rem] w-full rounded-[1.2rem] object-cover object-top sm:h-[23rem] lg:h-[26rem]"
            loading="eager"
          />
        </div>

        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-[1.25rem] border border-[var(--border-soft)] bg-[var(--bg-card-strong)] p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Core stack</p>
            <p class="mt-1.5 text-[0.96rem] font-semibold text-[var(--text-primary)]">.NET, React, Astro, TypeScript</p>
          </div>
          <div class="rounded-[1.25rem] border border-[var(--border-soft)] bg-[var(--bg-card-strong)] p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Modo de trabajo</p>
            <p class="mt-1.5 text-[0.96rem] font-semibold text-[var(--text-primary)]">Pensamiento sistémico con delivery pragmático</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
