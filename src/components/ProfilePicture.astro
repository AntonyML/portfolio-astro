---
import SafeImage from "./SafeImage.astro";
const totalCaseStudies = 2;
---

<section id="home" class="section-space hero-section scroll-mt-24">
  <div class="page-wrap">
    <div class="hero-grid items-center">
      <div class="flex flex-col gap-6">
        <div class="inline-flex w-fit items-center gap-2 rounded-full border border-[var(--border-soft)] bg-[var(--bg-card)] px-3 py-1.5 text-[0.85rem] text-[var(--text-secondary)] shadow-[var(--shadow-card)]">
          <span class="h-2 w-2 rounded-full bg-[var(--success)]"></span>
          Disponible para proyectos y colaboración remota.
        </div>

        <div class="space-y-3">
          <p class="eyebrow">Antony Jafeth Monge López</p>
          <h1 class="hero-title max-w-4xl font-bold uppercase text-[var(--text-primary)]">
            Construyo software
            <span class="block text-[var(--accent-strong)]">claro, útil y listo</span>
            para producción.
          </h1>
          <p class="hero-lead">
            Ingeniero de Software con experiencia en sistemas empresariales de escritorio y formación Full-Stack. He desarrollado e implementado soluciones de punto de venta e inventario para clientes en República Dominicana.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="#contact" class="button-primary">
            Contactar
            <i class="bx bx-right-arrow-alt text-xl" aria-hidden="true"></i>
          </a>
          <a href="https://github.com/AntonyML" target="_blank" rel="noopener noreferrer" class="button-secondary">GitHub</a>
          <a href="https://www.linkedin.com/in/antony-monge-lopez/" target="_blank" rel="noopener noreferrer" class="button-ghost">LinkedIn</a>
        </div>

        <div class="hero-stat-grid">
          <div class="section-card p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Experiencia aplicada</p>
            <p class="mt-1.5 text-[1.65rem] font-extrabold text-[var(--text-primary)]">{totalCaseStudies}</p>
            <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Sistemas reales documentados en este portafolio.</p>
          </div>
          <div class="section-card p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Especialidad</p>
            <p class="mt-1.5 text-base font-extrabold text-[var(--text-primary)]">Sistemas empresariales</p>
            <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Ventas, inventario, usuarios y lógica de negocio.</p>
          </div>
          <div class="section-card p-3.5">
            <p class="text-xs uppercase tracking-[0.18em] text-[var(--text-muted)]">Enfoque</p>
            <p class="mt-1.5 text-base font-extrabold text-[var(--text-primary)]">Full-Stack práctico</p>
            <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Implementación directa, arquitectura clara y foco en producción.</p>
          </div>
        </div>
      </div>

      <aside class="section-card relative overflow-hidden p-3 sm:p-4">
        <div class="absolute inset-x-10 top-0 h-24 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>
        <div class="relative rounded-[1.5rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-2">
          <div class="absolute left-3 top-3 rounded-full border border-[var(--border-soft)] bg-[var(--bg-card)] px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-[var(--text-secondary)]">
            Arquitectura de software
          </div>

          <SafeImage
            imageName="image-profile"
            alt="Retrato de Antony Monge"
            class="h-[18rem] w-full rounded-[1.2rem] object-cover object-top sm:h-[21rem] lg:h-[24rem]"
            loading="eager"
          />
        </div>
      </aside>
    </div>
  </div>
</section>
