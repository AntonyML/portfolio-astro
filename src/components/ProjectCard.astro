---
import SafeImage from "./SafeImage.astro";
import TechChip from "./TechChip.astro";

interface Props {
  id: string;
  title: string;
  type: string;
  role: string;
  description: string;
  highlights: string[];
  stack: string[];
  image: string;
}

const { title, type, role, description, highlights, stack, image } = Astro.props;
---

<a
  href={`/${image}`}
  class="group section-card flex h-full flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:border-[var(--border-strong)]"
  transition:name={`image-${image}`}
  aria-label={`Abrir caso de estudio de ${title}`}
>
  <div class="relative overflow-hidden">
    <SafeImage
      imageName={image}
      alt={`Vista previa del proyecto ${title}`}
      class="project-image"
      loading="lazy"
    />
    <div class="absolute inset-x-3 bottom-3 flex">
      <span
        class="inline-flex max-w-full rounded-full border border-[var(--border-strong)] bg-[var(--bg-card-strong)] px-2 py-1 text-[0.65rem] font-bold uppercase leading-snug tracking-[0.05em] text-[var(--text-primary)]"
      >
        {type}
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div>
      <p class="accent-label text-sm font-semibold">{role}</p>
      <h3 class="mt-2 text-[1.08rem] font-extrabold leading-6 text-[var(--text-primary)]">{title}</h3>
      <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">{description}</p>
    </div>

    <ul class="grid gap-1.5">
      {highlights.slice(0, 2).map((highlight) => (
        <li class="flex gap-3 text-sm leading-6 text-[var(--text-primary)]">
          <span
            class="accent-marker mt-1.5 h-2.5 w-2.5 rounded-full"
            aria-hidden="true"
          ></span>
          <span>{highlight}</span>
        </li>
      ))}
    </ul>

    <div class="mt-auto flex flex-wrap gap-2">
      {stack.slice(0, 5).map((tech) => (
        <TechChip tech={tech} />
      ))}
    </div>

    <div class="accent-label flex items-center gap-2 text-sm font-bold">
      Ver proyecto
      <i class="bx bx-right-arrow-alt text-xl transition duration-300 group-hover:translate-x-1" aria-hidden="true"></i>
    </div>
  </div>
</a>
