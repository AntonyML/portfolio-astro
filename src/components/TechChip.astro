---
import { Image } from "astro:assets";
import { techMap } from "../assets/data";

interface Props {
  tech: string;
}

const { tech } = Astro.props;
const logo = techMap[tech];
const isUrl = logo?.startsWith("http");
---

<span class="inline-flex items-center gap-2 rounded-full border border-[var(--border-soft)] bg-[var(--bg-soft)] px-3 py-1.5 text-xs font-semibold text-[var(--text-secondary)]">
  {logo && (
    isUrl ? (
      <Image
        src={logo}
        alt=""
        width={16}
        height={16}
        class="h-4 w-4 object-contain"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    ) : (
      <i class={logo} aria-hidden="true"></i>
    )
  )}
  {tech}
</span>
