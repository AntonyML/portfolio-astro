---
import { buttons, experience } from "../assets/data";
import TechChip from "./TechChip.astro";
---

<section id="experience" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="mb-6">
      <p class="eyebrow">Experiencia profesional</p>
      <h2 class="section-title max-w-4xl">Experiencia real construyendo software para operación de negocio.</h2>
      <p class="section-copy">
        Mi parte más sólida hoy está en consultoría freelance internacional: sistemas de escritorio para ventas, inventario, usuarios y control operativo en entornos reales.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      {experience.map((job) => (
        <article class="section-card flex h-full flex-col overflow-hidden p-5 sm:p-6">
          <div class="mb-4 flex flex-wrap items-start justify-between gap-3 border-b border-[var(--border-soft)] pb-4">
            <div class="space-y-2.5">
              <span
                class="inline-flex items-center rounded-full px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.16em]"
                style={`background: ${job.color}15; color: ${job.color}; border: 1px solid ${job.color}45;`}
              >
                Proyecto internacional
              </span>
              <div>
                <h3 class="text-[1.08rem] font-extrabold leading-6 text-[var(--text-primary)]">{job.projectTitle}</h3>
                <p class="mt-1 text-sm text-[var(--text-secondary)]">{job.role} · {job.origin}</p>
              </div>
            </div>

            <div class="rounded-2xl border border-[var(--border-soft)] bg-[var(--bg-soft)] px-3.5 py-2.5 text-right">
              <p class="text-xs uppercase tracking-[0.16em] text-[var(--text-muted)]">Periodo</p>
              <p class="mt-1 text-sm font-semibold text-[var(--text-primary)]">{job.period}</p>
            </div>
          </div>

          <p class="text-[0.98rem] leading-7 text-[var(--text-secondary)]">{job.description}</p>

          <ul class="mt-4 grid gap-2.5">
            {job.highlights.slice(0, 2).map((highlight) => (
              <li class="flex gap-3 text-sm leading-6 text-[var(--text-primary)]">
                <span
                  class="mt-1.5 h-2.5 w-2.5 rounded-full"
                  style={`background:${job.color}; box-shadow: 0 0 0 5px ${job.color}22;`}
                  aria-hidden="true"
                ></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>

          <div class="mt-5 flex flex-1 flex-col justify-end gap-4">
            <div class="flex flex-wrap gap-2">
              {job.stack.map((tech) => (
                <TechChip tech={tech} />
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a href={`/${job.image}`} class="button-secondary">
                Ver proyecto
                <i class="bx bx-right-arrow-alt text-xl" aria-hidden="true"></i>
              </a>
              {job.github && (
                <a
                  href={job.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="button-ghost"
                >
                  <i class={buttons[0].github} aria-hidden="true"></i>
                  Repositorio
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
