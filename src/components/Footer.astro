---
const socials = [
  { label: "GitHub", icon: "bx bxl-github", href: "https://github.com/AntonyML" },
  { label: "LinkedIn", icon: "bx bxl-linkedin-square", href: "https://www.linkedin.com/in/antony-monge-lopez/" },
  { label: "Instagram", icon: "bx bxl-instagram", href: "https://www.instagram.com/tony_m_l_/" },
];
---

<footer class="pb-10 pt-4">
  <div class="page-wrap">
    <div class="section-card flex flex-col gap-6 px-6 py-6 sm:px-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="font-['Space_Mono'] text-sm font-bold uppercase tracking-[0.16em] text-[var(--text-muted)]">Antony Monge</p>
          <p class="mt-3 text-base leading-7 text-[var(--text-secondary)]">
            Portafolio diseñado para mostrar criterio de producto, ingeniería y ejecución. Construido con Astro y una capa visual optimizada para claridad, accesibilidad y rendimiento.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="button-secondary"
            >
              <i class={social.icon} aria-hidden="true"></i>
              {social.label}
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-3 border-t border-[var(--border-soft)] pt-5 text-sm text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; 2026 Antony Monge. Todos los derechos reservados.</p>
        <a href="#home" class="muted-link">Volver arriba</a>
      </div>
    </div>
  </div>
</footer>
