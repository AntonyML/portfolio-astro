---
const socials = [
  { label: "GitHub", icon: "bx bxl-github", href: "https://github.com/AntonyML" },
  { label: "LinkedIn", icon: "bx bxl-linkedin-square", href: "https://www.linkedin.com/in/antony-monge-lopez/" },
  { label: "Instagram", icon: "bx bxl-instagram", href: "https://www.instagram.com/tony_m_l_/" },
];
---

<footer class="pt-3 pb-6">
  <div class="page-wrap">
    <div class="section-card flex flex-col gap-4 px-5 py-4 sm:px-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <p class="font-['Space_Mono'] text-sm font-bold uppercase tracking-[0.16em] text-[var(--text-muted)]">Antony Monge</p>
          <p class="mt-2 text-[0.92rem] leading-6 text-[var(--text-secondary)]">
            Ingeniero de Software enfocado en sistemas empresariales y desarrollo Full-Stack.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="button-secondary"
            >
              <i class={social.icon} aria-hidden="true"></i>
              {social.label}
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-2 border-t border-[var(--border-soft)] pt-3 text-xs text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; 2026 Antony Monge. Todos los derechos reservados.</p>
        <a href="#home" class="muted-link">Volver arriba</a>
      </div>
    </div>
  </div>
</footer>
