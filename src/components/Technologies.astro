---
import { technologies } from "../assets/data";
import TechnologyCard from "./TechnologyCard.astro";
---

<section id="stack" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="section-card p-5 sm:p-6 lg:p-8">
      <div class="mb-8 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow">Stack y prácticas</p>
          <h2 class="section-title max-w-4xl">Tecnologías elegidas por criterio, no por moda.</h2>
        </div>
        <p class="max-w-lg text-[0.98rem] leading-7 text-[var(--text-secondary)]">
          Herramientas, frameworks y patrones que utilizo para construir software robusto, usable y preparado para evolucionar.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {technologies.map((tech) => (
          <TechnologyCard text={tech.text} logo={tech.logo} />
        ))}
      </div>
    </div>
  </div>
</section>
