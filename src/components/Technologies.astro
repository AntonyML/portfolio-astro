---
import { skills } from "../assets/data";
---

<section id="skills" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="section-card p-5 sm:p-6 lg:p-6">
      <div class="mb-6">
        <p class="eyebrow">Habilidades</p>
        <h2 class="section-title max-w-4xl">Stack que uso en la práctica.</h2>
        <p class="section-copy">
          Tecnologías de backend, sistemas empresariales e implementación orientada a producto.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {skills.map((group) => (
          <section class="rounded-[1.35rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-4 sm:p-5">
            <h3 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">{group.title}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="pill">{item}</span>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>
