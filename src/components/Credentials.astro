---
import { credentials } from "../assets/data";
---

<section id="credentials" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="mb-6">
      <p class="eyebrow">Educación y credenciales</p>
      <h2 class="section-title max-w-4xl">Formación, certificaciones y contexto profesional.</h2>
      <p class="section-copy">
        Base académica en sistemas empresariales. Certificaciones de tecnología. Práctica en evolución constante.
      </p>
    </div>

    <div class="section-card p-5 sm:p-6 lg:p-6">
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_18rem]">
        <section class="rounded-[1.35rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-4 sm:p-5">
          <h3 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">Educación</h3>
          <div class="mt-4 grid gap-4">
            {credentials.education.map((item) => (
              <article class="rounded-[1.1rem] border border-[var(--border-soft)] bg-[var(--bg-card-strong)] p-4">
                <p class="text-[0.98rem] font-semibold text-[var(--text-primary)]">{item.title}</p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]">{item.institution}</p>
                <p class="mt-2 text-xs uppercase tracking-[0.14em] text-[var(--text-muted)]">{item.period}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="rounded-[1.35rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-4 sm:p-5">
          <h3 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">Certificaciones</h3>
          <ul class="mt-4 grid gap-3">
            {credentials.certifications.map((item) => (
              <li class="flex gap-3 text-sm leading-6 text-[var(--text-primary)]">
                <span class="mt-1.5 h-2.5 w-2.5 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="rounded-[1.35rem] border border-[var(--border-soft)] bg-[var(--bg-card-strong)] p-4 sm:p-5">
          <h3 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">Idiomas</h3>
          <div class="mt-4 grid gap-3">
            {credentials.languages.map((item) => (
              <div class="rounded-[1rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] px-3.5 py-3 text-sm font-medium text-[var(--text-primary)]">
                {item}
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>
