---
import SafeImage from "./SafeImage.astro";

interface Props {
  text: string;
  logo: string;
}

const { text, logo } = Astro.props;
const isUrl = logo.startsWith("http");
---

<div class="rounded-[1.25rem] border border-[var(--border-soft)] bg-[var(--bg-soft)] p-3.5 transition duration-300 hover:-translate-y-1 hover:border-[var(--border-strong)] hover:bg-[var(--bg-card-strong)]">
  <div class="flex items-center gap-4">
    <div class="grid h-10 w-10 shrink-0 place-items-center rounded-[1rem] border border-[var(--border-soft)] bg-[var(--bg-card)] text-xl text-[var(--text-primary)]">
      {isUrl ? (
        <SafeImage
          imageName={logo.replace(".webp", "").replace("/", "")}
          alt={`Logo de ${text}`}
          class="h-7 w-7 object-contain"
        />
      ) : (
        <i class={logo} aria-hidden="true"></i>
      )}
    </div>

    <div>
      <p class="text-[0.96rem] font-semibold text-[var(--text-primary)]">{text}</p>
      <p class="mt-1 text-sm leading-5 text-[var(--text-secondary)]">Parte del toolkit de entrega y arquitectura.</p>
    </div>
  </div>
</div>
