---
import { projects } from "../assets/data";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="mb-6 flex flex-col gap-2.5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Proyectos destacados</p>
        <h2 class="section-title max-w-4xl">Dos sistemas que resumen bien cómo trabajo.</h2>
      </div>
      <p class="max-w-lg text-[0.94rem] leading-6 text-[var(--text-secondary)]">
        No son ejercicios de laboratorio. Son casos basados en necesidades reales, decisiones prácticas y software pensado para usarse.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      {projects.map((card) => (
        <ProjectCard
          id={card.id}
          title={card.title}
          type={card.type}
          role={card.role}
          description={card.description}
          highlights={card.highlights}
          stack={card.stack}
          image={card.image}
          color={card.color}
        />
      ))}
    </div>
  </div>
</section>
