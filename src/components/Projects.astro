---
import { projects } from "../assets/data";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects" class="section-space scroll-mt-24">
  <div class="page-wrap">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Proyectos destacados</p>
        <h2 class="section-title max-w-4xl">Casos de estudio donde la ingeniería y la experiencia se encuentran.</h2>
      </div>
      <p class="max-w-lg text-[0.98rem] leading-7 text-[var(--text-secondary)]">
        Portafolio pensado como evidencia de criterio: arquitectura, trade-offs, calidad y resultados tangibles.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      {projects.map((card) => (
        <ProjectCard
          id={card.id}
          title={card.title}
          type={card.type}
          role={card.role}
          description={card.description}
          highlights={card.highlights}
          stack={card.stack}
          image={card.image}
          color={card.color}
        />
      ))}
    </div>
  </div>
</section>
