---
import Form from "../components/Form.astro";
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Navbar from "../components/Navbar.astro";
import Projects from "../components/Projects.astro";
import ProfilePicture from "../components/ProfilePicture.astro";
import Footer from "../components/Footer.astro";
import WorkExperience from "../components/WorkExperience.astro";
import Technologies from "../components/Technologies.astro";
---

<Layout
  title="Antony Monge | Arquitectura de software, UX y sistemas empresariales"
  description="Portafolio de Antony Monge con proyectos, consultorías y casos de estudio sobre arquitectura de software, front-end moderno, accesibilidad y sistemas empresariales."
  canonicalPath="/"
>
   <Navbar />

   <main id="main-content">
      <ProfilePicture />
      <WorkExperience />
      <Projects />
      <Technologies />
      <About />
      <Form />
   </main>
   <Footer />
</Layout>
