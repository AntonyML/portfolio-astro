---
const { id } = Astro.params;
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { buttons, experience, projects } from "../assets/data";
import TechChip from "../components/TechChip.astro";
import SafeImage from "../components/SafeImage.astro";

export function getStaticPaths() {
  return [
    ...projects.map((project) => ({ params: { id: project.image } })),
    ...experience.map((job) => ({ params: { id: job.image } })),
  ];
}

const baseCard = projects.find((project) => project.image === id);
const job = experience.find((item) => item.image === id);

if (!baseCard && !job) {
  return Astro.redirect("/");
}

const card = baseCard ?? {
  id: job!.id,
  title: job!.projectTitle,
  type: "Consultoría · Contrato",
  role: job!.role,
  description: job!.description,
  highlights: job!.highlights,
  stack: job!.stack,
  image: job!.image,
  color: job!.color,
  github: job!.github ?? "",
};

type DetailSection = {
  title: string;
  content: string;
  tone: "neutral" | "accent";
};

const detailSections = [
  card.challenge && { title: "Desafío", content: card.challenge, tone: "neutral" },
  card.solution && { title: "Solución", content: card.solution, tone: "accent" },
  card.architecture && { title: "Arquitectura y decisiones", content: card.architecture, tone: "neutral" },
  job?.context && { title: "Contexto técnico", content: job.context, tone: "neutral" },
  card.testing && { title: "Testing y calidad", content: card.testing, tone: "accent" },
  card.management && { title: "Gestión", content: card.management, tone: "neutral" },
  (card.impact || job?.impact) && { title: "Impacto", content: card.impact ?? job!.impact, tone: "accent" },
].filter((section): section is DetailSection => Boolean(section));

const dualRepos = "githubFront" in card || "githubBack" in card;
---

<Layout
  title={`${card.title} | Caso de estudio`}
  description={card.description}
  canonicalPath={`/${id}/`}
  image={`/${id}.webp`}
  ogType="article"
>
  <Navbar />

  <main id="main-content" class="section-space">
    <div class="page-wrap">
      <a href={job && !baseCard ? "/#experience" : "/#projects"} class="button-ghost mb-6">
        <i class={buttons[0].back} aria-hidden="true"></i>
        {job && !baseCard ? "Volver a experiencia" : "Volver a proyectos"}
      </a>

      <div class="grid gap-5 xl:grid-cols-[minmax(0,1.05fr)_20rem]">
        <section class="section-card p-5 sm:p-6">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="inline-flex rounded-full px-3 py-1 text-[0.72rem] font-bold uppercase tracking-[0.16em]"
              style={`background:${card.color}18; color:${card.color}; border:1px solid ${card.color}44;`}
            >
              {card.type}
            </span>
            <span class="pill">{card.role}</span>
            {job && <span class="pill">Proyecto pagado</span>}
          </div>

          <h1 class="mt-5 font-['Space_Mono'] text-[clamp(2.1rem,4.3vw,3.7rem)] font-bold uppercase leading-[0.98] tracking-[-0.05em] text-[var(--text-primary)]">
            {card.title}
          </h1>

          <p class="mt-4 max-w-3xl text-[1rem] leading-7 text-[var(--text-secondary)]">{card.description}</p>

          <div class="mt-6 flex flex-wrap gap-3">
            {dualRepos ? (
              <>
                {"githubFront" in card && card.githubFront && (
                  <a
                    href={card.githubFront}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="button-primary"
                    style={`background:${card.color};`}
                  >
                    <i class={buttons[0].github} aria-hidden="true"></i>
                    Frontend
                  </a>
                )}
                {"githubBack" in card && card.githubBack && (
                  <a
                    href={card.githubBack}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="button-secondary"
                  >
                    <i class={buttons[0].github} aria-hidden="true"></i>
                    Backend
                  </a>
                )}
              </>
            ) : card.github ? (
              <a
                href={card.github}
                target="_blank"
                rel="noopener noreferrer"
                class="button-primary"
                style={`background:${card.color};`}
              >
                <i class={buttons[0].github} aria-hidden="true"></i>
                Ver repositorio
              </a>
            ) : (
              <span class="button-secondary cursor-default opacity-70">Repositorio privado</span>
            )}
          </div>
        </section>

        <aside class="section-card p-3.5 sm:p-4">
          <SafeImage
            imageName={id}
            alt={`Vista del proyecto ${card.title}`}
            class="h-full min-h-[15rem] w-full rounded-[1.35rem] object-cover object-top lg:min-h-[18rem]"
            loading="eager"
          />
        </aside>
      </div>

      <div class="mt-5 grid gap-5 xl:grid-cols-[minmax(0,1fr)_20rem]">
        <section class="space-y-4">
          {detailSections.map((section) => (
            <article
              class:list={[
                "detail-section rounded-[1.5rem] border p-5 sm:p-6",
                section.tone === "accent"
                  ? "border-transparent bg-[var(--bg-muted)]"
                  : "border-[var(--border-soft)] bg-[var(--bg-card)]",
              ]}
            >
              <h2 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">{section.title}</h2>
              <p class="mt-3 text-[0.98rem] leading-7 text-[var(--text-secondary)]">{section.content}</p>
            </article>
          ))}

          <article class="section-card p-5 sm:p-6">
            <h2 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">Puntos clave</h2>
            <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
              {card.highlights.map((highlight) => (
                <li class="flex gap-3 text-sm leading-7 text-[var(--text-primary)]">
                  <span
                    class="mt-2 h-2.5 w-2.5 rounded-full"
                    style={`background:${card.color}; box-shadow:0 0 0 5px ${card.color}22;`}
                    aria-hidden="true"
                  ></span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          </article>
        </section>

        <aside class="space-y-4">
          <section class="section-card p-4 sm:p-5">
            <h2 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">Stack tecnológico</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {card.stack.map((tech) => (
                <TechChip tech={tech} />
              ))}
            </div>
          </section>

          {card.artifacts && card.artifacts.length > 0 && (
            <section class="section-card p-4 sm:p-5">
              <h2 class="text-sm font-extrabold uppercase tracking-[0.16em] text-[var(--text-primary)]">Artefactos de ingeniería</h2>
              <div class="mt-4 flex flex-wrap gap-2">
                {card.artifacts.map((artifact) => (
                  <span class="pill">{artifact}</span>
                ))}
              </div>
            </section>
          )}
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
